{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "isolatedModules": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "noEmit": true, "types": ["node"]
  },
  "include": ["ui/src", "tests", "scripts", "vite.config.ts", "playwright.config.ts"]
}
