{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinkScope 2", "version": "2.0.0", "identifier": "local.linkscope.v2",
  "build": {"beforeDevCommand":"npm run dev","beforeBuildCommand":"npm run build","devUrl":"http://127.0.0.1:1420","frontendDist":"../dist"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"LinkScope","width":1440,"height":920,"minWidth":850,"minHeight":580,"backgroundColor":"#181a1e"}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"}
  },
  "bundle": {"active":false,"icon":["icons/icon.ico","icons/icon.png"]}
}
